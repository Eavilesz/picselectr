# Copy this file to .env.local and fill in your values.

# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 — https://dash.cloudflare.com/<account-id>/r2/overview/api-tokens
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket-public-url

# Resend — https://resend.com/api-keys (optional, email notifications are skipped if unset)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Picselectr <onboarding@resend.dev>

# OpenRouter — https://openrouter.ai/settings/keys (semantic photo search embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key

# Signs the PIN access cookies for /select and /gallery. Any long random
# string (e.g. `openssl rand -hex 32`). Falls back to the service role key.
GALLERY_ACCESS_SECRET=your-random-secret
